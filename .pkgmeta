package-as: HolyMath

ignore:
  - .github
  - README.md
  - AGENTS.md
  - media
  - tests
  - tools
  - "*.png"
  - "**/*.png"
  - "*.jpg"
  - "**/*.jpg"
  - "*.jpeg"
  - "**/*.jpeg"
  - "*.webp"
  - "**/*.webp"
  - .gitignore
  - .pkgmeta

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no
